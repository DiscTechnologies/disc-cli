# Disc CLI dev script environment config
# Copy to .env.local or .env.prod and fill in values.
# Usage: ./disc.sh --env local <command>
#        ./disc.sh --env prod  <command>
#        ./disc.sh <command>          # defaults to --env local

# HTTP base URL for the Disc API
DISC_HTTP_BASE_URL=http://localhost:3001

# WebSocket URL for Disc signal streams
DISC_WS_URL=ws://localhost:8097

# Client ID tag attached to connections (helps identify traffic source in logs)
DISC_CLIENT_ID=disc-cli-local

# OAuth defaults for `disc auth login`; production defaults are compiled in.
# Override these only for local development or a self-hosted Disc environment.
DISC_OAUTH_ISSUER=https://sso.local.disc.tech/realms/disc
DISC_OAUTH_CLIENT_ID=disc-cli
DISC_OAUTH_SCOPE=openid profile email disc-cli

# API key — optional compatibility path for non-interactive automation.
# Leave empty to use the selected OAuth profile or the key stored by
# `disc auth api-key set`.
DISC_API_KEY=
